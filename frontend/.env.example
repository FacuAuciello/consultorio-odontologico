# Todas las variables del front empiezan con VITE_ (Vite solo expone esas al navegador).
# Copiá este archivo como ".env" para cambiar los valores. Ninguna es obligatoria.

# URL base de la API. Vacío = mismo origen (en desarrollo el proxy de Vite reenvía /api al backend).
# En producción, si el back vive en otro dominio: VITE_API_URL=https://api.midominio.com
VITE_API_URL=

# A dónde reenvía el proxy de Vite en desarrollo
VITE_PROXY_TARGET=http://localhost:8080

# Textos que se muestran en el menú, el login y el mensaje de WhatsApp (los nombres de este repo son ficticios)
VITE_NOMBRE_CONSULTORIO=Consultorio Odontológico
VITE_NOMBRE_PROFESIONAL=Dr. Demo (ficticio)
