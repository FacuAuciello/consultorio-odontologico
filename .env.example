# Variables de entorno del BACKEND y de docker-compose.
# Copiá este archivo como ".env" y completá los valores. NUNCA subas el ".env" real a GitHub.

# --- Base de datos ---
DB_URL=jdbc:mysql://localhost:3306/consultorio_odontologico?createDatabaseIfNotExist=true&serverTimezone=America/Argentina/Buenos_Aires
DB_USER=root
DB_PASSWORD=cambiar-esta-clave

# --- Seguridad ---
# En producción (con HTTPS) poner true: la cookie de sesión viaja solo cifrada
SESSION_COOKIE_SECURE=false

# --- Usuario inicial ---
# Se crea al arrancar si todavía no existe (la contraseña se guarda hasheada con BCrypt)
ADMIN_USUARIO=admin
ADMIN_CONTRASENIA=cambiar-esta-clave

# --- CORS ---
# Dominio del front. En desarrollo es el de Vite
CORS_ORIGEN=http://localhost:5173
